# Local projects, including source, assets, caches, and rendered videos.
/videos/

# Credentials stay local; only the empty setup example is public.
.env
.env.*
!.env.example
*.pem
*.key

node_modules/
.DS_Store
*.log

# Share only portable skill packs, never local agent settings or sessions.
/.agents/*
!/.agents/skills/
/.claude/*
!/.claude/skills/

# Upstream Pixabay audio is not redistributable as our raw sound library.
/.agents/skills/media-use/audio/assets/sfx/*.mp3

# Generated documentation viewer and Python helper caches.
/doc/
__pycache__/
*.pyc
